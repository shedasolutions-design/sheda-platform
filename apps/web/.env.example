# ──────────────────────────────────────────────────────────────────────────
# Sheda web app. Copy to .env.local and fill in. .env.local is gitignored.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle and are public.
# Everything else stays on the server and never reaches the browser.
# ──────────────────────────────────────────────────────────────────────────

# The API (services/backend on Railway, database on Neon).
NEXT_PUBLIC_API_URL=https://api-production-1e044370.up.railway.app
# Optional second deployment for read failover. Only one that shares the SAME
# database; leave empty otherwise.
NEXT_PUBLIC_API_URL_FALLBACK=

# Google sign-in (OAuth "Web application" client). Add
#   <your origin>/google-auth
# as an Authorized redirect URI in Google Cloud Console for every origin the
# app is served from (http://localhost:3000 for development).
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=333938897540-tt7udprd6mf22erf0go6nfonkn7hqkit.apps.googleusercontent.com

# Encrypted wallet backup (optional). Firebase web config is public by design.
NEXT_PUBLIC_FEATURE_CLOUD_BACKUP=true
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── SERVER ONLY ──────────────────────────────────────────────────────────
# Funding account that pays for new users' NEAR accounts. Read only by
# src/server/sponsor.ts. NEVER prefix these with NEXT_PUBLIC_.
# Without it, signup still works: new users get a free testnet name or an
# implicit account instead of a branded *.shedauser.testnet one.
NEAR_TESTNET_FUNDING_PRIVATE_KEY=
NEAR_MAINNET_FUNDING_PRIVATE_KEY=

# testnet (default) or mainnet. Anything else means testnet.
NEXT_PUBLIC_NEAR_NETWORK=testnet

# Optional. Point the app at a raise or stake deployment that is not in
# src/config/collections.ts yet. Leave empty to use the table, which is what
# a plain build and local development do. See docs/DEPLOY_COLLECTIONS.md.
NEXT_PUBLIC_RAISE_CONTRACT_ID=
NEXT_PUBLIC_STAKE_REGISTRY_ID=
