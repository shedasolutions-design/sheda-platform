# ──────────────────────────────────────────────────
# Sheda Solutions Mobile — Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored and must NOT be committed.
#
# HOW IT WORKS:
#   1. Expo automatically loads .env at build/dev time
#   2. app.config.ts reads process.env and injects keys into `extra`
#   3. The app reads them via Constants.expoConfig.extra at runtime
#
# FOR EAS BUILDS:
#   Set these as EAS Secrets via:
#     eas secret:create --name NEAR_TESTNET_FUNDING_PRIVATE_KEY --value "ed25519:..."
#     eas secret:create --name NEAR_MAINNET_FUNDING_PRIVATE_KEY --value "ed25519:..."
#
# ⚠️  SECURITY: These keys are NOT prefixed with EXPO_PUBLIC_
#     so they are NOT directly exposed as client-side env vars.
# ──────────────────────────────────────────────────

# Backend API base URL — public, safe to expose (EXPO_PUBLIC_ prefix).
# Overrides app.json's extra.apiUrl when set.
#
# There are two live deployments, sharing one database:
#
#   https://sheda.peni.dev                 Cloudflare Workers — preferred, faster, no cold start
#   https://sheda-backend-1.onrender.com   Render — fallback
#
# Because they share a database, the same account sees the same listings and
# appointments either way, so moving between them is a change of route rather
# than a change of data. The app prefers the first and falls back to the second
# when it is unreachable (services/apiEndpoints.ts). Reads are retried across
# them; writes never are, since a timed-out write may already have been applied.
#
# The deploy workflow takes a `backend` input (cloudflare | render) choosing
# which is preferred, and refuses to build if EITHER is missing the appointment
# endpoints — a fallback that cannot serve them breaks the moment it is needed.
EXPO_PUBLIC_API_URL=https://sheda.peni.dev

# Google OAuth 2.0 "Web application" Client ID — public, safe to expose.
# Used by the "Sign in with Google" button on Login/Signup (config/google.ts,
# hooks/useGoogleAuth.ts). Must match the backend's GOOGLE_CLIENT_ID setting,
# since the backend verifies the returned id_token's audience against it.
# Without this set, the Google button shows a clear "not configured" error
# instead of silently failing.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=333938897540-tt7udprd6mf22erf0go6nfonkn7hqkit.apps.googleusercontent.com

# Testnet funding account (sheda.testnet)
NEAR_TESTNET_FUNDING_ACCOUNT_ID=sheda.testnet
NEAR_TESTNET_FUNDING_PRIVATE_KEY=ed25519:YOUR_TESTNET_FUNDING_KEY_HERE

# Mainnet funding account (shedauser.near)
NEAR_MAINNET_FUNDING_ACCOUNT_ID=shedauser.near
NEAR_MAINNET_FUNDING_PRIVATE_KEY=ed25519:YOUR_MAINNET_FUNDING_KEY_HERE

# ──────────────────────────────────────────────────
# Feature flags
# ──────────────────────────────────────────────────
# Encrypted cloud backup UI. Safe to leave on: with no Firebase config below,
# the feature reports itself unavailable and renders nothing.
EXPO_PUBLIC_FEATURE_CLOUD_BACKUP=true

# ──────────────────────────────────────────────────
# Firebase — encrypted wallet backup (services/cloudBackup.ts)
# ──────────────────────────────────────────────────
# These are PUBLIC by design and carry the EXPO_PUBLIC_ prefix. A Firebase web
# API key is a project identifier, not a credential — it authorises nothing on
# its own. All access control lives in the Firestore security rules, which
# restrict every document to its owning request.auth.uid. The rules are printed
# in NEAR_WALLET_README.md; deploy them BEFORE enabling backup in production.
#
# Firebase never receives a seed phrase: the blob is AES-256-GCM ciphertext
# before upload, and the passphrase that decrypts it is never transmitted.
#
# Setup: create a Firebase project, enable Google as a sign-in provider, create
# a Firestore database, and paste the web app config values here. The Google
# OAuth client is the SAME one as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID above —
# add it under Firebase Auth > Sign-in method > Google > Web SDK configuration.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=

# The other deployment, used when the preferred one is unreachable.
# Set empty to disable failover entirely.
EXPO_PUBLIC_API_URL_FALLBACK=https://sheda-backend-1.onrender.com
