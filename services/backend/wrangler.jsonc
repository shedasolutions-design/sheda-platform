/**
 * Sheda API on Cloudflare Workers (Python).
 *
 *   uv run pywrangler dev       run locally in workerd
 *   uv run pywrangler deploy    deploy
 *
 * Everything secret is set with `npx wrangler secret put <NAME>`, never here:
 *   DATABASE_URL         Neon connection string (or DB_URL)
 *   SECRET_KEY           JWT signing key
 *   ADMIN_SECRET_KEY     admin panel session key
 *   BREVO_API_KEY        transactional email
 *   CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET, CLOUDINARY_URL
 *   PINATA_JWT, PINATA_API_KEY, PINATA_API_SECRET
 *   GOOGLE_CLIENT_ID
 * And, because they belong to the new accounts:
 *   CLOUDINARY_NAME, SMTP_SEND_FROM_MAIL, PINATA_GATEWAY_URL
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sheda-api",
	"main": "src/worker.py",
	"compatibility_date": "2026-09-21",
	"compatibility_flags": ["python_workers"],
	"observability": { "enabled": true },
	"vars": {
		"API_V_STR": "/api/v1",
		"ALGORITHM": "HS256",
		"ACCESS_TOKEN_EXPIRE_MINUTES": "30",
		"REFRESH_TOKEN_EXPIRE_DAYS": "20",
		"VERIFICATION_CODE_EXP_MIN": "15",
		"DEBUG_MODE": "False",
		"DEV_URL": "http://localhost:8787",
		"PROD_URL": "https://sheda-api.workers.dev",
		"ORIGINS": "[\"*\"]",
		"SMTP_HOST": "smtp-relay.brevo.com",
		"SMTP_PORT": "2525",
		"PINATA_URL": "https://uploads.pinata.cloud/v3/files",
		"ADMIN_ROUTE": "/sheda-backend",
		"ADMIN_PREFIX": "sheda-backend",
		"ADMIN_SITE_NAME": "Sheda Admin",
		"ADMIN_PRIMARY_COLOR": "#c62828",
		"ADMIN_SITE_FAVICON": "/static/sheda-solutions.png",
		"ADMIN_SITE_HEADER_LOGO": "/static/sheda-solutions.png",
		"ADMIN_SITE_SIGN_IN_LOGO": "/static/sheda-solutions.png",
		"ADMIN_USER_MODEL": "Admin",
		"ADMIN_USER_MODEL_USERNAME_FIELD": "username",
		"ADMIN_SEED_ENABLED": "False"
	}
}
